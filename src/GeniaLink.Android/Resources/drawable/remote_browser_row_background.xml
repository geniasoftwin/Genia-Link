<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <inset android:insetLeft="3dp" android:insetTop="2dp" android:insetRight="3dp" android:insetBottom="2dp">
            <shape android:shape="rectangle">
                <solid android:color="#EEF6FF" />
                <stroke android:width="1dp" android:color="#B8D8F5" />
                <corners android:radius="11dp" />
            </shape>
        </inset>
    </item>
    <item>
        <inset android:insetLeft="3dp" android:insetTop="2dp" android:insetRight="3dp" android:insetBottom="2dp">
            <shape android:shape="rectangle">
                <solid android:color="#FFFFFF" />
                <stroke android:width="1dp" android:color="#E2E8F0" />
                <corners android:radius="11dp" />
            </shape>
        </inset>
    </item>
</selector>
