<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="52dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/remote_browser_row_background"
    android:paddingStart="7dp"
    android:paddingTop="4dp"
    android:paddingEnd="6dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/remote_browser_icon"
        android:layout_width="30dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="18sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="7dp"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/remote_browser_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textColor="#172033"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/remote_browser_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#64748B"
            android:textSize="11sp" />
    </LinearLayout>

    <CheckBox
        android:id="@+id/remote_browser_check"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:buttonTint="#0B73D9"
        android:clickable="false"
        android:focusable="false"
        android:gravity="center" />
</LinearLayout>
