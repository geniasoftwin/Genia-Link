<Window x:Class="GeniaLink.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Genia Link" Icon="Assets/GeniaLink.ico" Height="650" Width="980" MinHeight="600" MinWidth="860"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" StateChanged="Window_StateChanged"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Compact work header: brand, current local state, one overflow menu. -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0" Source="Assets/GeniaLink.png" Width="40" Height="40" Stretch="Uniform" Margin="0,0,10,0"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Genia Link" FontSize="23" FontWeight="SemiBold"/>
                <TextBlock x:Name="ServiceStatusTextBlock" Text="Запуск локальных служб…" FontSize="12.5" Opacity="0.72" Margin="0,1,0,0"/>
            </StackPanel>
            <Button Grid.Column="2" x:Name="MenuButton" Content="⋮" Style="{StaticResource QuietButton}"
                    Width="42" Height="34" Padding="0" FontSize="20" VerticalAlignment="Center" Click="MenuButton_Click">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Настройки" Click="SettingsButton_Click"/>
                        <MenuItem Header="Открыть папку Genia Link" Click="OpenReceiveFolderButton_Click"/>
                        <Separator/>
                        <MenuItem x:Name="ForgetSelectedMenuItem" Header="Забыть выбранное устройство" IsEnabled="False" Click="ForgetButton_Click"/>
                        <MenuItem x:Name="DiagnosticsMenuItem" Header="Показать диагностику" Click="DiagnosticsMenuItem_Click"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </Grid>

        <!-- The detailed local identity remains available to existing code/settings, but no longer occupies the work surface. -->
        <Grid Visibility="Collapsed">
            <TextBlock x:Name="LocalDeviceNameTextBlock"/>
            <TextBlock x:Name="LocalIpTextBlock"/>
            <TextBlock x:Name="FingerprintTextBlock"/>
            <TextBlock x:Name="ReceiveFolderTextBlock"/>
            <Button x:Name="OpenReceiveFolderButton" Click="OpenReceiveFolderButton_Click"/>
            <Button x:Name="SettingsButton" Click="SettingsButton_Click"/>
            <Button x:Name="ForgetButton" Click="ForgetButton_Click"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.9*"/>
                <ColumnDefinition Width="1.3*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#33000000" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Устройства" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock DockPanel.Dock="Right" x:Name="DeviceCountTextBlock" Opacity="0.58" VerticalAlignment="Center"/>
                    </DockPanel>

                    <ListBox x:Name="DevicesListBox" Grid.Row="1" SelectionChanged="DevicesListBox_SelectionChanged" HorizontalContentAlignment="Stretch">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Background="#08000000" CornerRadius="5" Padding="7,4" Margin="2,6,2,2">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Opacity="0.66"/>
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" Margin="1" BorderBrush="#1F000000" BorderThickness="0,0,0,1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13.5"/>
                                        <TextBlock Text="{Binding DetailText}" Margin="0,2,0,0" FontSize="12" Opacity="0.68"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Grid.Row="2" x:Name="PairButton" Content="Сопрячь" MinWidth="112" MinHeight="32" Padding="14,6" Margin="0,9,0,0"
                            HorizontalAlignment="Left" HorizontalContentAlignment="Center" Visibility="Collapsed" IsEnabled="False" Click="PairButton_Click"/>
                </Grid>
            </Border>

            <Border Grid.Column="1" BorderBrush="#33000000" BorderThickness="1" CornerRadius="9" Padding="14" Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Передача" FontSize="17" FontWeight="SemiBold"/>
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="SelectedDeviceTextBlock" Text="Выберите устройство слева"
                                   FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" x:Name="BrowseRemoteButton" Content="Файлы" Width="86" Style="{StaticResource QuietButton}"
                                Margin="8,0,0,0" IsEnabled="False" Click="BrowseRemoteButton_Click"/>
                    </Grid>

                    <Border Grid.Row="2" BorderBrush="#2A000000" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,10,0,0" Background="#06000000">
                        <StackPanel>
                            <TextBlock Text="Перетащите файлы сюда или выберите их" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock x:Name="SelectedFilesTextBlock" Text="Файлы не выбраны" Margin="0,3,0,0" FontSize="12" TextWrapping="Wrap" MaxHeight="44" Opacity="0.72"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Выбрать файлы" Width="120" Click="ChooseFilesButton_Click"/>
                        <Button Content="Выбрать папку" Width="120" Margin="7,0,0,0" Click="ChooseFolderButton_Click"/>
                        <Button x:Name="SendButton" Content="Отправить" Width="100" Style="{StaticResource PrimaryButton}" Margin="7,0,0,0" IsEnabled="False" Click="SendButton_Click"/>
                        <Button x:Name="CancelSendButton" Content="Отмена" Width="88" Margin="7,0,0,0" IsEnabled="False" Click="CancelSendButton_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Margin="0,12,0,0">
                        <DockPanel Margin="0,0,0,5">
                            <TextBlock x:Name="ProgressTextBlock" Text="Готово" FontWeight="SemiBold" FontSize="12.5"/>
                            <TextBlock x:Name="SpeedTextBlock" DockPanel.Dock="Right" FontSize="12" Opacity="0.68"/>
                        </DockPanel>
                        <ProgressBar x:Name="TransferProgressBar" Height="11" Minimum="0" Maximum="100"/>
                    </StackPanel>

                    <Border x:Name="DiagnosticsPanel" Grid.Row="5" Visibility="Collapsed" Margin="0,12,0,0"
                            BorderBrush="#26000000" BorderThickness="1" CornerRadius="7" Padding="1">
                        <TextBox x:Name="LogTextBox" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                 TextWrapping="Wrap" Padding="8" FontFamily="Consolas" FontSize="11.5" BorderThickness="0"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Margin="0,10,0,0" Opacity="0.52" FontSize="11.5"
                   Text="Локальная сеть · без аккаунта и облака · защищённое соединение"/>
    </Grid>
</Window>
