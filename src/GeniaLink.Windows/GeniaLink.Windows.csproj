<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>0.3.1</Version>
    <AssemblyVersion>0.3.1.0</AssemblyVersion>
    <FileVersion>0.3.1.0</FileVersion>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>GeniaLink.Windows</RootNamespace>
    <AssemblyName>GeniaLink</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\GeniaLink.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\GeniaLink.Core\GeniaLink.Core.csproj" />
    <Resource Include="Assets\GeniaLink.ico" />
    <Resource Include="Assets\GeniaLink.png" />
  </ItemGroup>
</Project>
