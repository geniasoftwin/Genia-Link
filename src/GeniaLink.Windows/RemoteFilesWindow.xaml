<Window x:Class="GeniaLink.Windows.RemoteFilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Файлы Genia Link" Height="560" Width="820" MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="Assets/GeniaLink.ico"
        PreviewKeyDown="Window_PreviewKeyDown" Closed="Window_Closed">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleTextBlock" FontSize="21" FontWeight="SemiBold" Text="Файлы Genia Link"/>
        <TextBlock Grid.Row="1" Margin="0,4,0,12" Opacity="0.64" TextWrapping="Wrap" FontSize="12.5"
                   Text="Удалённая папка Genia Link на доверенном устройстве."/>

        <Grid Grid.Row="2" Margin="0,0,0,9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="UpButton" Width="38" Height="32" Content="↑" ToolTip="На уровень выше" Click="UpButton_Click"/>
            <TextBlock x:Name="PathTextBlock" Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center"
                       FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="Genia Link"/>
            <Button x:Name="RefreshButton" Grid.Column="2" Height="32" MinWidth="92" Margin="0,0,8,0"
                    Content="Обновить" Click="RefreshButton_Click"/>
            <ComboBox x:Name="SortComboBox" Grid.Column="3" Width="142" Height="32" SelectedIndex="0"
                      SelectionChanged="SortComboBox_SelectionChanged">
                <ComboBoxItem Content="Имя"/>
                <ComboBoxItem Content="Дата"/>
                <ComboBoxItem Content="Размер"/>
            </ComboBox>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="520"/>
                <ColumnDefinition x:Name="PreviewSpacerColumn" Width="0"/>
                <ColumnDefinition x:Name="PreviewColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#22000000" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                <ListBox x:Name="FilesListBox" SelectionMode="Extended" HorizontalContentAlignment="Stretch"
                         BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="FilesListBox_SelectionChanged" MouseDoubleClick="FilesListBox_MouseDoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="ToolTip" Value="{Binding RelativePath}"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,7" BorderBrush="#16000000" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Icon}" FontFamily="Segoe UI Emoji" FontSize="18"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Margin="6,0,8,0">
                                        <TextBlock Text="{Binding Name}" FontSize="13.3" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding DetailText}" FontSize="11.5" Opacity="0.58"
                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border x:Name="PreviewPanel" Grid.Column="2" Visibility="Collapsed" BorderBrush="#22000000" BorderThickness="1" CornerRadius="8" Background="#FAFBFC" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="PreviewTitleTextBlock" FontSize="15" FontWeight="SemiBold" Text="Предпросмотр" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="PreviewMetaTextBlock" Grid.Row="1" Margin="0,4,0,10" FontSize="11.5" Opacity="0.62"
                               Text="Выберите один файл" TextWrapping="Wrap"/>
                    <Grid Grid.Row="2">
                        <Image x:Name="PreviewImage" Stretch="Uniform" Visibility="Collapsed"/>
                        <TextBox x:Name="PreviewTextBox" IsReadOnly="True" Visibility="Collapsed" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas"
                                 FontSize="11.5" BorderThickness="0" Background="Transparent"/>
                        <TextBlock x:Name="PreviewMessageTextBlock" Text="Двойной щелчок по файлу или кнопка «Предпросмотр»."
                                   VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                   MaxWidth="250" Opacity="0.58"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SelectionTextBlock" Margin="2,0,16,0" VerticalAlignment="Center" Opacity="0.68"
                       Text="Файлы не выбраны" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
            <Button x:Name="PreviewButton" Grid.Column="1" Content="Просмотр" MinWidth="96" ToolTip="Предпросмотр фото и текстовых файлов" Margin="0,0,8,0"
                    IsEnabled="False" Click="PreviewButton_Click"/>
            <Button x:Name="DownloadButton" Grid.Column="2" Content="Скачать" Width="104" IsDefault="True"
                    Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="DownloadButton_Click"/>
        </Grid>
    </Grid>
</Window>
